# =============================================================================
# RPC & KEYS (required for scriptMaster.sh)
# =============================================================================
# RPC URLs.
ARBITRUM_MAINNET_RPC_URL=
ARBITRUM_SEPOLIA_RPC_URL=

# Deployer private key (no 0x prefix or with).
DEPLOYER_PRIVATE_KEY=

# Etherscan API key (required for verification).
ETHERSCAN_API_KEY=

# =============================================================================
# CONTRACT PROXY ADDRESSES
# =============================================================================

# GLOBAL CONTRACTS
TOPIC_CATALOG_PROXY=
TRUSTED_ISSUERS_REGISTRY_PROXY=
CLAIMS_REGISTRY_PROXY=
EMISSION_DEPLOYER_MANAGER=
TOKEN_FACTORY_PROXY=

# EMISSION CONTRACTS
IDENTITY_REGISTRY_PROXY=
COMPLIANCE_BASE_PROXY=
IDENTITY_FACTORY_PROXY=
CLAIM_TOPICS_REGISTRY_PROXY=

# =============================================================================
# CREATE EMISSION VIA TOKENFACTORY
# =============================================================================
# EMISSION_ID=emission-demo
# EMISSION_NAME=Demo Emission
# EMISSION_SYMBOL=DEMO
# EMISSION_MAX_SUPPLY=1000000000000000000000
#
# EMISSION_TREASURY=
# EMISSION_ADMIN=
# EMISSION_COMPLIANCE_ADMIN=
# EMISSION_AGENT=

# =============================================================================
# IDENTITY OPERATIONS 
# =============================================================================
# EMISSION_ID=emission-demo
#
# Create Identity:
# IDENTITY_USER_ID_HASH=0x
# IDENTITY_ADMIN=
#
# Bind Wallet -> Identity:
# BIND_WALLET=
# BIND_IDENTITY=

# =============================================================================
# IDENTITY VERIFICATION (manual, optional)
# =============================================================================
# IDENTITY_CONTRACT=0x0000000000000000000000000000000000000000
#   Address of an Identity instance to verify on Etherscan when using
#   the "Verify Identity contract (manual)" option in the Identity menu.
#   Uses the same IDENTITY_USER_ID_HASH and IDENTITY_ADMIN values as when
#   the identity was originally created.

# =============================================================================
# CLAIMS OPERATIONS 
# =============================================================================
# Shared:
# TOKEN_FACTORY_PROXY=
# EMISSION_ID=emission-demo
#
# TopicCatalog (global):
# TOPIC_ID=1
# TOPIC_CODE=KYC
# TOPIC_DESCRIPTION=Know your customer
# TOPIC_ACTIVE=true
#
# Trusted issuer:
# ISSUER=
# ISSUER_TRUSTED=true
#
# Claims:
# CLAIM_IDENTITY=
# CLAIM_TOPIC=1
# CLAIM_DATA_HASH=0x
# CLAIM_VALID_TO=1735689600
#
# Freeze modes:
# FREEZE_WALLET=
# FREEZE_IDENTITY=
# FREEZE_MODE=0
# Freeze mode enum:
# 0 NONE, 1 FULL, 2 SEND_ONLY, 3 RECEIVE_ONLY, 4 ONLY_TO_TREASURY
#
# ComplianceBase (emission): Add / remove module (menu Compliance 12–13):
# MODULE_TO_ADD=0x...     # address of IComplianceModule to add
# MODULE_TO_REMOVE=0x...  # address of module to remove

# Treasury transfer debug script (script/transfer/TreasuryTransfer.s.sol):
# TRANSFER_TOKEN=0x...              # address of Token3643
# TRANSFER_RECIPIENT=0x...          # destination address
# TRANSFER_AMOUNT=1000000000000000000
# TRANSFER_SENDER_PRIVATE_KEY=0x... # optional; if unset, uses DEPLOYER_PRIVATE_KEY

# =============================================================================
# AIRDROP SCRIPT (script/airdrop.ts)
# =============================================================================
# NETWORK_KEY=arbitrum_sepolia
#   - Must match a key in script/networks.json.
#   - Used to load deployments/addresses/<NETWORK_KEY>.json.
#
# TREASURY_PRIVATE_KEY=0x...
#   - Private key of the treasury wallet for the chosen emission/network.
#   - Must correspond to deployments/addresses/<NETWORK_KEY>.json -> emissions[EMISSION_ID].contracts.treasury.
